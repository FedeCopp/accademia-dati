---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url, pad, weekSlug } from '../../lib/url';
import { CodeExercise } from '@/components/ui/code-exercise';

export async function getStaticPaths() {
  const weeks = (await getCollection('settimane')).sort((a, b) => a.data.numero - b.data.numero);
  return weeks.map((w, i) => ({
    params: { slug: weekSlug(w.data.numero) },
    props: { week: w, prev: weeks[i - 1], next: weeks[i + 1] },
  }));
}

const { week, prev, next } = Astro.props;
const { Content } = await render(week);
const d = week.data;
const mese = Math.ceil(d.numero / 4);
const esercizi = d.esercizi;
const exIds = JSON.stringify(esercizi.map((e) => e.id));
const steps = [
  { id: 'obiettivo', t: 'Obiettivo' },
  { id: 'studia', t: 'Cosa studiare' },
  { id: 'spiegazione', t: 'Spiegazione' },
  ...(esercizi.length ? [{ id: 'esercitati', t: 'Esercitati qui' }] : []),
  { id: 'esercizio', t: 'Esercizio della settimana' },
  { id: 'fatto', t: 'Segna come fatta' },
];
---
<Base title={`Settimana ${d.numero}: ${d.titolo}`} description={d.obiettivo} current="fase-1" readingBar>
  <article data-week-state={d.numero}>
    <header class="lesson-head">
      <div class="container">
        <nav class="crumbs" aria-label="Percorso di navigazione" data-intro style="--i:0">
          <a href={url('/fase-1/')}><Icon name="arrow-left" size={14} /> Tutte le lezioni</a>
        </nav>
        <span class="eyebrow" data-intro style="--i:0">Settimana {pad(d.numero)} di 12 · mese {mese}</span>
        <h1 data-intro style="--i:1">{d.titolo}</h1>
        <p class="lead" data-intro style="--i:2">{d.sottotitolo}</p>
        <div class="meta" data-intro style="--i:3">
          <span><Icon name="clock" size={16} /> 5–8 ore · 3 sessioni</span>
          <span class="state-todo"><Icon name="circle" size={16} /> Da fare</span>
          <span class="state-done"><Icon name="check-circle" size={16} /> Completata</span>
          {esercizi.length > 0 && (
            <a class="ex-count" href="#esercitati"><Icon name="terminal" size={16} /> <span data-ex-progress data-ids={exIds}>0 / {esercizi.length}</span> esercizi superati</a>
          )}
        </div>
        <div class="weekbar" aria-hidden="true" data-intro style="--i:3">
          {Array.from({ length: 12 }, (_, i) => <span class:list={['seg', { cur: i + 1 === d.numero }]} data-week-state={i + 1} />)}
        </div>
      </div>
    </header>

    <div class="container grid">
      <aside class="toc-col">
        <nav class="toc" data-toc aria-label="In questa lezione">
          <p class="toc-h">In questa lezione</p>
          <ol>{steps.map((s, i) => <li><a href={`#${s.id}`}><span>{i + 1}</span>{s.t}</a></li>)}</ol>
        </nav>
      </aside>

      <div class="main">
        <section id="obiettivo" class="step" data-step data-reveal>
          <h2 class="step-h"><span class="n">1</span>Obiettivo</h2>
          <p class="goal">{d.obiettivo}</p>
        </section>

        <section id="studia" class="step" data-step data-reveal>
          <h2 class="step-h"><span class="n">2</span>Cosa studiare</h2>
          <ul class="study">{d.studio.map((s) => <li><Icon name="book" size={18} /><span>{s}</span></li>)}</ul>
          <div class="res">
            <p class="res-h">Risorse</p>
            <ul>
              {d.risorse.map((r) => (
                <li><a href={r.url} target="_blank" rel="noopener"><span>{r.titolo}</span><Icon name="link" size={14} /></a></li>
              ))}
            </ul>
          </div>
        </section>

        <section id="spiegazione" class="step" data-step>
          <h2 class="step-h" data-reveal><span class="n">3</span>Spiegazione</h2>
          <div class="prose"><Content /></div>
        </section>

        {esercizi.length > 0 && (
          <section id="esercitati" class="step" data-step>
            <h2 class="step-h" data-reveal><span class="n">4</span>Esercitati qui</h2>
            <p class="muted ex-intro" data-reveal>Scrivi il codice nell'editor, premi <b>Esegui</b> per vedere il risultato e <b>Verifica</b> per sapere se è corretto. Gira tutto nel tuo browser, con dati di esempio.</p>
            <div class="ex-list">
              {esercizi.map((e, i) => <CodeExercise client:visible ex={e} numero={i + 1} />)}
            </div>
          </section>
        )}

        <section id="esercizio" class="step" data-step data-reveal>
          <h2 class="step-h"><span class="n">{esercizi.length ? 5 : 4}</span>Esercizio della settimana</h2>
          <div class="exercise">
            <Icon name="pencil" size={20} />
            <p>{d.esercizio}</p>
          </div>
          {d.fatto && (
            <div class="dod">
              <p class="dod-h"><Icon name="check-circle" size={18} /> Il progetto è finito quando</p>
              <ul>{d.fatto.map((f) => <li>{f}</li>)}</ul>
            </div>
          )}
        </section>

        <section id="fatto" class="step" data-step data-reveal>
          <h2 class="step-h"><span class="n">{esercizi.length ? 6 : 5}</span>Segna come fatta</h2>
          <div class="done-box">
            <p class="muted">Hai fatto l'esercizio e scritto le tre righe nel diario? Segna la settimana: il progresso si aggiorna e la prossima lezione diventa quella evidenziata.</p>
            <button class="btn btn-primary btn-done" type="button" data-week-toggle={d.numero} aria-pressed="false" data-label-todo="Segna la settimana come fatta" data-label-done="Completata · annulla">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span data-label>Segna la settimana come fatta</span>
            </button>
          </div>
        </section>

        <nav class="pager" aria-label="Lezioni vicine">
          {prev ? (
            <a class="card card-hover pg" href={url(`/fase-1/${weekSlug(prev.data.numero)}/`)}>
              <span class="muted"><Icon name="arrow-left" size={16} /> Settimana {prev.data.numero}</span><strong>{prev.data.titolo}</strong>
            </a>
          ) : <span class="pg-empty" />}
          {next ? (
            <a class="card card-hover pg pg-next" href={url(`/fase-1/${weekSlug(next.data.numero)}/`)}>
              <span class="muted">Settimana {next.data.numero} <Icon name="arrow-right" size={16} /></span><strong>{next.data.titolo}</strong>
            </a>
          ) : (
            <a class="card card-hover pg pg-next" href={url('/percorso/#fase-2')}>
              <span class="muted">Prossima fase <Icon name="arrow-right" size={16} /></span><strong>Fase 2 · Trasformare i dati</strong>
            </a>
          )}
        </nav>
      </div>
    </div>
  </article>
</Base>

<style>
  .lesson-head { position: relative; padding-block: clamp(2rem, 5vw, 3.5rem) var(--space-2xl); background: linear-gradient(180deg, color-mix(in srgb, var(--color-primary-soft) 60%, transparent), transparent); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-2xl); }
  .lesson-head .container { display: grid; gap: var(--space-sm); justify-items: start; }
  .lesson-head .lead { max-width: var(--measure); }
  .crumbs a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; font-size: 0.9rem; font-weight: 500; color: var(--color-muted-foreground); text-decoration: none; }
  .crumbs a:hover { color: var(--color-primary); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-lg); color: var(--color-muted-foreground); font-size: 0.9rem; margin-top: var(--space-xs); }
  .meta span { display: inline-flex; align-items: center; gap: 6px; }
  .ex-count { display: inline-flex; align-items: center; gap: 6px; color: var(--color-primary); font-weight: 600; text-decoration: none; }
  .ex-count:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ex-intro { max-width: var(--measure); }
  .ex-list { display: grid; gap: var(--space-lg); min-width: 0; }
  .state-done { display: none !important; color: var(--color-success); font-weight: 600; }
  .is-done .state-todo { display: none !important; }
  .is-done .state-done { display: inline-flex !important; }
  .weekbar { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; margin-top: var(--space-md); width: min(100%, 420px); }
  .seg { height: 6px; border-radius: 3px; background: var(--color-border); transition: background-color var(--dur-base) var(--ease); }
  .seg.is-done { background: var(--color-success); }
  .seg.cur { background: var(--color-primary); }
  .seg.cur.is-done { background: var(--color-success); box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-primary); }

  .grid { display: grid; gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .grid { grid-template-columns: 220px minmax(0, 1fr); } }
  .toc-col { display: none; }
  @media (min-width: 1000px) { .toc-col { display: block; } }
  .toc { position: sticky; top: calc(var(--header-h) + 32px); }
  .toc-h { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted-foreground); margin-bottom: var(--space-sm); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 2px solid var(--color-border); }
  .toc a { display: flex; gap: 10px; align-items: center; min-height: 36px; padding-left: 14px; margin-left: -2px; border-left: 2px solid transparent; color: var(--color-muted-foreground); text-decoration: none; font-size: 0.92rem; transition: color var(--dur-fast) var(--ease), border-color var(--dur-base) var(--ease); }
  .toc a span { font-family: var(--font-mono); font-size: 0.78rem; }
  .toc a:hover { color: var(--color-foreground); }
  .toc a[aria-current] { color: var(--color-primary); border-left-color: var(--color-primary); font-weight: 600; }

  .main { display: grid; gap: var(--space-3xl); min-width: 0; max-width: 760px; }
  .step { display: grid; gap: var(--space-md); scroll-margin-top: calc(var(--header-h) + 24px); }
  .step-h { display: flex; align-items: center; gap: var(--space-md); font-size: clamp(1.35rem, 2.6vw, 1.7rem); }
  .n { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: none; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 600; background: var(--color-primary-soft); color: var(--color-primary); }
  .goal { font-size: 1.2rem; font-weight: 500; line-height: 1.5; padding: var(--space-lg); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-primary); }
  .study { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .study li { display: flex; gap: var(--space-sm); align-items: flex-start; font-size: 1.02rem; }
  .study :global(svg) { color: var(--color-primary); flex: none; margin-top: 4px; }
  .res { margin-top: var(--space-sm); padding: var(--space-md) var(--space-lg); border-radius: var(--radius-lg); background: var(--color-muted); }
  .res-h { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted-foreground); margin-bottom: 6px; }
  .res ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .res a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; font-weight: 600; }
  .main :global(.prose) { max-width: none; }
  .main :global(.prose h2) { font-size: 1.15rem; margin-top: var(--space-md); }
  .main :global(.prose p), .main :global(.prose li) { font-size: 1.04rem; line-height: 1.7; }
  .exercise { display: flex; gap: var(--space-md); padding: var(--space-lg); border-radius: var(--radius-lg); background: var(--color-accent-soft); border: 1px solid color-mix(in srgb, var(--color-accent-fill) 30%, transparent); }
  .exercise :global(svg) { color: var(--color-accent); flex: none; margin-top: 3px; }
  .exercise p { font-size: 1.08rem; font-weight: 500; }
  .dod { padding: var(--space-lg); border-radius: var(--radius-lg); border: 1.5px dashed var(--color-success); }
  .dod-h { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--color-success); margin-bottom: var(--space-sm); }
  .dod ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; }
  .done-box { display: grid; gap: var(--space-md); justify-items: start; padding: var(--space-xl); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-md); }
  .btn-done { min-height: 52px; padding: 0.8rem 1.4rem; font-size: 1rem; border-radius: 12px; }
  .btn-done path { fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; }
  .is-done .btn-done { background: var(--color-success); color: var(--color-surface); }
  .is-done .btn-done path { animation: draw 420ms var(--ease-out) both; }
  .is-done .done-box { border-color: var(--color-success); }

  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .pg-empty { display: none; } }
  .pg { display: grid; gap: 4px; padding: var(--space-lg); text-decoration: none; color: inherit; }
  .pg .muted { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; }
  .pg-next { text-align: right; justify-items: end; }
</style>
