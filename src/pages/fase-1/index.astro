---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProgressCard from '../../components/ProgressCard.astro';
import { url, pad, weekSlug } from '../../lib/url';

const weeks = (await getCollection('settimane')).sort((a, b) => a.data.numero - b.data.numero);
const months = [1, 2, 3].map((m) => ({ m, weeks: weeks.filter((w) => Math.ceil(w.data.numero / 4) === m) }));
const monthTitles = ['Strumenti e Python', 'SQL', 'pandas e primo progetto'];
---
<Base title="Fase 1, le 12 lezioni" description="Le dodici settimane della Fase 1: Python, terminale, SQL, pandas, visualizzazione e il primo progetto." current="fase-1">
  <section class="section">
    <div class="container layout">
      <div class="section-head">
        <span class="eyebrow">Fase 1 · Fondamenta · mesi 1–3</span>
        <h1>Le prime 12 settimane</h1>
        <p class="lead">Apri una lezione, segui il piano, fai l'esercizio e segnala come fatta. I progressi restano salvati in questo browser.</p>
      </div>
      <div class="aside"><ProgressCard /></div>
    </div>
    <div class="container">
      {months.map(({ m, weeks }) => (
        <div class="month">
          <h2 class="month-title"><span class="eyebrow">Mese {m}</span> {monthTitles[m - 1]}</h2>
          <ol class="weeks">
            {weeks.map((w) => (
              <li class="week card" data-week-state={w.data.numero}>
                <a class="week-link" href={url(`/fase-1/${weekSlug(w.data.numero)}/`)}>
                  <span class="num">{pad(w.data.numero)}</span>
                  <span class="txt">
                    <strong>{w.data.titolo}</strong>
                    <span class="muted">{w.data.sottotitolo}</span>
                  </span>
                </a>
                <button class="toggle" type="button" data-week-toggle={w.data.numero} aria-pressed="false" aria-label={`Settimana ${w.data.numero} completata`} data-label-todo="Da fare" data-label-done="Fatta">
                  <span class="box" aria-hidden="true"><Icon name="check" size={14} /></span>
                  <span data-label>Da fare</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <div class="reset">
        <button class="btn btn-ghost" type="button" data-progress-reset>Azzera i progressi</button>
        <span class="muted" data-reset-msg aria-live="polite"></span>
      </div>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: var(--space-xl); grid-template-columns: minmax(0, 1fr); align-items: end; margin-bottom: var(--space-xl); }
  .layout .section-head { margin-bottom: 0; }
  @media (min-width: 900px) { .layout { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  .month + .month { margin-top: var(--space-2xl); }
  .month-title { display: flex; align-items: baseline; gap: var(--space-md); font-size: 1.2rem; margin-bottom: var(--space-md); flex-wrap: wrap; }
  .weeks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .week { display: flex; align-items: center; gap: var(--space-sm); padding-right: var(--space-sm); transition: border-color 180ms var(--ease), background-color 180ms var(--ease); }
  .week:hover { border-color: var(--color-primary); }
  .week-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--space-md); padding: var(--space-md) var(--space-lg); color: inherit; text-decoration: none; min-height: 64px; }
  .num { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600; color: var(--color-primary); font-variant-numeric: tabular-nums; width: 2ch; flex: none; }
  .txt { display: grid; min-width: 0; }
  .txt .muted { font-size: 0.9rem; }
  .toggle {
    flex: none; display: inline-flex; align-items: center; gap: var(--space-sm); min-height: 44px; padding: 0 0.75rem;
    border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-muted-foreground); font: 500 0.85rem var(--font-body); cursor: pointer;
    transition: background-color 180ms var(--ease), color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .toggle:hover { border-color: var(--color-border-strong); color: var(--color-foreground); }
  .box { width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid var(--color-border-strong); display: grid; place-items: center; color: transparent; transition: inherit; }
  .is-done { background: var(--color-success-soft); border-color: transparent; }
  .is-done .num { color: var(--color-success); }
  .is-done .toggle { color: var(--color-success); border-color: transparent; background: transparent; font-weight: 600; }
  .is-done .box { background: var(--color-success); border-color: var(--color-success); color: var(--color-surface); }
  .reset { margin-top: var(--space-xl); display: flex; gap: var(--space-md); align-items: center; flex-wrap: wrap; }
  @media (max-width: 520px) {
    .week-link { padding: var(--space-md); gap: var(--space-sm); }
    .toggle [data-label] { display: none; }
    .toggle { padding: 0 0.7rem; }
  }
</style>
