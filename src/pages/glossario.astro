---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const terms = (await getCollection('glossario')).map((t) => t.data).sort((a, b) => a.termine.localeCompare(b.termine, 'it'));
---
<Base title="Glossario" description="Le parole del mestiere dei dati e della sicurezza, spiegate in modo semplice." current="glossario">
  <section class="section">
    <div class="container">
      <div class="section-head" data-intro>
        <span class="eyebrow">Le parole del mestiere</span>
        <h1>Glossario</h1>
        <p class="lead">{terms.length} termini che incontrerai nel percorso, spiegati in una o due frasi.</p>
      </div>
      <div class="search">
        <label for="gq">Filtra i termini</label>
        <input id="gq" type="search" placeholder="es. join, ETL, CVE" autocomplete="off" />
        <p class="muted" id="gcount" aria-live="polite"></p>
      </div>
      <dl class="gloss" data-reveal-group>
        {terms.map((t) => (
          <div class="row" data-term={`${t.termine} ${t.definizione}`.toLowerCase()}>
            <dt>{t.termine}</dt>
            <dd>{t.definizione}</dd>
          </div>
        ))}
      </dl>
      <p class="empty muted" hidden id="gempty">Nessun termine trovato. Prova con una parola più corta.</p>
    </div>
  </section>
</Base>
<script>
  document.addEventListener('astro:page-load', () => {
  const input = document.getElementById('gq') as HTMLInputElement | null;
  if (!input) return;
  const rows = [...document.querySelectorAll<HTMLElement>('.gloss .row')];
  const count = document.getElementById('gcount')!;
  const empty = document.getElementById('gempty')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    rows.forEach((r) => { const ok = !q || (r.dataset.term ?? '').includes(q); r.hidden = !ok; if (ok) n++; });
    count.textContent = q ? `${n} risultati` : '';
    empty.hidden = n > 0;
  });
  });
</script>
<style>
  .search { display: grid; gap: var(--space-xs); max-width: 480px; margin-bottom: var(--space-xl); }
  .search label { font-weight: 600; font-size: 0.92rem; }
  .search input { font: inherit; min-height: 48px; padding: 0 var(--space-md); border-radius: var(--radius-md); border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-foreground); }
  .search p { font-size: 0.85rem; min-height: 1.3em; }
  .gloss { margin: 0; max-width: 860px; }
  .row { display: grid; grid-template-columns: minmax(130px, 200px) minmax(0, 1fr); gap: var(--space-lg); padding-block: var(--space-md); border-bottom: 1px solid var(--color-border); }
  dt { font-family: var(--font-mono); font-weight: 600; color: var(--color-primary); }
  dd { margin: 0; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; gap: 2px; } }
</style>
