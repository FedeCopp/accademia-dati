---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { DecryptText } from '@/components/ui/decrypt-text';
---
<Base title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <section class="section">
    <div class="container prose">
      <span class="eyebrow">Errore 404</span>
      <DecryptText client:load as="h1" text="Questa pagina non esiste" trigger="mount" loop={false} stagger={40} />
      <p>Forse il link è vecchio o c'è un errore di battitura. Riparti dal <a href={url('/percorso/')}>percorso</a> o dalle <a href={url('/fase-1/')}>lezioni della Fase 1</a>.</p>
    </div>
  </section>
</Base>
