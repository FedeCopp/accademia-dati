---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Cerca" description="Cerca tra lezioni, fasi e glossario dell'Accademia Dati.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ricerca</span>
        <h1>Cerca nel sito</h1>
        <p class="lead">Cerca tra lezioni, fasi e glossario. Prova con “window function” o “pulizia”.</p>
      </div>
      <div id="search" class="pf"></div>
      <noscript><p>La ricerca richiede JavaScript.</p></noscript>
    </div>
  </section>
  <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
  <script is:inline define:vars={{ base }}>
    const s = document.createElement('script');
    s.src = `${base}/pagefind/pagefind-ui.js`;
    s.onload = () => new PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: { placeholder: 'Cerca una lezione o un termine', zero_results: 'Nessun risultato per [SEARCH_TERM]' } });
    s.onerror = () => { document.getElementById('search').textContent = 'La ricerca è disponibile solo nel sito pubblicato (npm run build && npm run preview).'; };
    document.body.appendChild(s);
  </script>
</Base>
<style>
  .pf { max-width: 760px;
    --pagefind-ui-primary: var(--color-primary); --pagefind-ui-text: var(--color-foreground);
    --pagefind-ui-background: var(--color-surface); --pagefind-ui-border: var(--color-border-strong);
    --pagefind-ui-tag: var(--color-muted); --pagefind-ui-border-radius: 10px; --pagefind-ui-font: var(--font-body); }
</style>
