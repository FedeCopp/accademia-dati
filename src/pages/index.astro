---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProgressCard from '../components/ProgressCard.astro';
import Roadmap from '../components/Roadmap.astro';
import { url } from '../lib/url';

const pipeline = [
  { code: 'extract', name: 'Raccogli', text: 'CSV, API e database con Python.', icon: 'download' },
  { code: 'clean', name: 'Pulisci', text: 'Mancanti, duplicati, date sbagliate.', icon: 'filter' },
  { code: 'model', name: 'Modella', text: 'Tabelle ordinate con SQL e dbt.', icon: 'layers' },
  { code: 'analyze', name: 'Analizza', text: 'Trend, statistica, un po\' di ML.', icon: 'chart' },
  { code: 'tell', name: 'Racconta', text: 'Grafici e dashboard che decidono.', icon: 'presentation' },
] as const;
const steps = [
  { t: 'Apri la lezione della settimana', d: 'Ogni settimana ha una pagina con obiettivo, cosa studiare e una breve spiegazione. Il sito ti indica sempre qual è la prossima.', icon: 'book' },
  { t: 'Studia e fai l\'esercizio', d: 'Tre sessioni: teoria, pratica e diario su GitHub. L\'esercizio è la parte che conta di più.', icon: 'pencil' },
  { t: 'Segnala come fatta', d: 'Un clic e il progresso si aggiorna. Ogni tre mesi chiudi una fase con un progetto da mostrare.', icon: 'check-circle' },
] as const;
---
<Base title="Accademia Dati" description="Un percorso di data intelligence da zero: 14 mesi, 5–8 ore a settimana, un progetto reale per ogni fase.">
  <section class="hero">
    <div class="bg dot-grid" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow pill" data-intro style="--i:0">Data intelligence · da zero · 5–8 ore a settimana</span>
        <h1 data-intro style="--i:1">Impara a trasformare i dati in <span class="hl">decisioni</span>.</h1>
        <p class="lead" data-intro style="--i:2">Un percorso guidato di 14 mesi, una lezione alla settimana. Ogni fase si chiude con un progetto vero su GitHub, che dimostra cosa sai fare.</p>
        <div class="cta" data-intro style="--i:3">
          <a class="btn btn-primary btn-lg" href={url('/fase-1/settimana-01/')} data-cta-start>
            <span data-label>Inizia dalla settimana 1</span><Icon name="arrow-right" />
          </a>
          <a class="btn btn-ghost btn-lg" href={url('/percorso/')}>Guarda il percorso</a>
        </div>
        <ul class="facts" data-intro style="--i:4">
          <li><Icon name="clock" size={16} /> 5–8 ore a settimana</li>
          <li><Icon name="flag" size={16} /> 5 progetti</li>
          <li><Icon name="book" size={16} /> Risorse gratuite</li>
        </ul>
      </div>
      <div class="hero-side" data-intro style="--i:3">
        <ProgressCard />
        <div class="terminal" aria-label="Esempio di query SQL della settimana 7">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>settimana-07.sql</span></div>
          <pre><code><span class="c">-- variazione mese su mese</span>
<span class="k">SELECT</span> mese, totale,
  totale - <span class="f">LAG</span>(totale)
    <span class="k">OVER</span> (<span class="k">ORDER BY</span> mese) <span class="k">AS</span> delta
<span class="k">FROM</span> mensile;<span class="cursor" aria-hidden="true"></span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Come funziona</span>
        <h2>Tre passi, ogni settimana</h2>
      </div>
      <ol class="steps" data-reveal-group>
        {steps.map((s, i) => (
          <li class="step card">
            <span class="step-num">{i + 1}</span>
            <span class="step-ico"><Icon name={s.icon} size={22} /></span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tinted">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Il percorso · circa 14 mesi</span>
        <h2>Cinque fasi, dalla prima riga di codice alla specializzazione</h2>
        <p class="lead">Parti dalla Fase 1. Le altre si sbloccano una dopo l'altra: clicca una tappa per vederne argomenti e progetto.</p>
      </div>
      <div data-reveal><Roadmap /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Cosa imparerai</span>
        <h2>La catena che porta un dato a una decisione</h2>
      </div>
      <ol class="pipe" data-reveal-group>
        {pipeline.map((s, i) => (
          <li class="pstep">
            <span class="p-ico"><Icon name={s.icon} size={20} /></span>
            <div>
              <h3>{s.name}</h3>
              <p class="muted">{s.text}</p>
            </div>
            {i < pipeline.length - 1 && <span class="p-arrow" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>}
          </li>
        ))}
      </ol>
      <div class="why" data-reveal-group>
        <p><Icon name="target" size={18} /><span><b>Risultati ogni settimana.</b> Una query, un grafico, una tabella pulita.</span></p>
        <p><Icon name="layers" size={18} /><span><b>Basi che valgono ovunque.</b> Python e SQL servono anche nella sicurezza.</span></p>
        <p><Icon name="shield" size={18} /><span><b>Ponte verso la cybersecurity.</b> <a href={url('/cybersecurity/')}>Scopri come</a></span></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="final card" data-reveal>
        <div>
          <h2>Pronto per la prima lezione?</h2>
          <p class="muted">Ti servono un computer e due ore. Si comincia installando gli strumenti.</p>
        </div>
        <a class="btn btn-primary btn-lg" href={url('/fase-1/settimana-01/')} data-cta-start>
          <span data-label>Inizia dalla settimana 1</span><Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5rem); }
  .bg { position: absolute; inset: 0; mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%); pointer-events: none; }
  .hero::after { content: ''; position: absolute; width: 520px; height: 520px; right: -120px; top: -180px; border-radius: 50%; background: radial-gradient(circle, var(--color-primary-soft), transparent 65%); pointer-events: none; z-index: 0; }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: var(--space-lg); justify-items: start; }
  .pill { padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--color-primary-soft); }
  .hl { color: var(--color-primary); position: relative; white-space: nowrap; }
  .hl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.06em; height: 0.12em; background: var(--color-accent-fill); opacity: .35; border-radius: 2px; transform-origin: left; }
  .js-motion .hl::after { animation: grow 900ms var(--ease-out) 700ms both; }
  @keyframes grow { from { transform: scaleX(0); } }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  :global(.btn-lg) { min-height: 52px; padding: 0.8rem 1.5rem; font-size: 1rem; border-radius: 12px; }
  .btn-primary :global(svg) { transition: transform var(--dur-base) var(--ease-out); }
  .btn-primary:hover :global(svg) { transform: translateX(3px); }
  .btn-primary { box-shadow: 0 8px 20px -10px var(--color-primary); }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); color: var(--color-muted-foreground); font-size: 0.92rem; }
  .facts li { display: inline-flex; align-items: center; gap: 6px; }
  .facts :global(svg) { color: var(--color-primary); }
  .hero-side { display: grid; gap: var(--space-md); min-width: 0; }
  .terminal { background: var(--code-bg); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .term-bar { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; border-bottom: 1px solid rgb(255 255 255 / .06); }
  .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 255 / .16); }
  .term-bar span { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--code-str); }
  .terminal pre { margin: 0; padding: var(--space-lg); color: var(--code-fg); font-family: var(--font-mono); font-size: 0.86rem; line-height: 1.7; overflow-x: auto; }
  .terminal code { background: none; padding: 0; }
  .k { color: var(--code-kw); } .f { color: var(--code-fn); } .c { color: var(--code-str); }
  .cursor { display: inline-block; width: 8px; height: 1.05em; margin-left: 4px; vertical-align: text-bottom; background: var(--code-kw); }
  .js-motion .cursor { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .center { margin-inline: auto; text-align: center; justify-items: center; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .step { position: relative; padding: var(--space-xl) var(--space-lg) var(--space-lg); display: grid; gap: var(--space-sm); align-content: start; }
  .step-num { position: absolute; top: var(--space-md); right: var(--space-lg); font-family: var(--font-mono); font-size: 2.6rem; font-weight: 600; line-height: 1; color: var(--color-muted); }
  .step-ico { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--color-primary-soft); color: var(--color-primary); margin-bottom: var(--space-xs); }

  .tinted { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-primary-soft) 45%, transparent) 30%, transparent); }

  .pipe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-md); }
  .pstep { position: relative; display: grid; gap: var(--space-sm); align-content: start; }
  .pstep h3 { font-size: 1.05rem; }
  .pstep p { font-size: 0.92rem; }
  .p-ico { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-primary); }
  .p-arrow { position: absolute; top: 12px; right: -4px; color: var(--color-border-strong); }
  @media (max-width: 860px) {
    .pipe { grid-template-columns: 1fr; gap: var(--space-md); }
    .pstep { grid-template-columns: 40px 1fr; gap: var(--space-md); align-items: center; }
    .p-arrow { display: none; }
  }
  .why { display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
  .why p { display: flex; gap: var(--space-sm); align-items: flex-start; font-size: 0.95rem; }
  .why :global(svg) { color: var(--color-primary); flex: none; margin-top: 3px; }

  .final { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-lg); padding: clamp(1.5rem, 4vw, 2.5rem); background: linear-gradient(120deg, var(--color-primary-soft), var(--color-surface) 70%); border-color: color-mix(in srgb, var(--color-primary) 30%, var(--color-border)); }
  .final > div { display: grid; gap: var(--space-xs); }
</style>
