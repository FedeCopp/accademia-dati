---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProgressCard from '../components/ProgressCard.astro';
import { url } from '../lib/url';

const pipeline = [
  { code: 'extract', name: 'Raccogli', text: 'File CSV, API, siti e database, con Python e richieste HTTP.', icon: 'download', fase: 'Fasi 1–2' },
  { code: 'clean', name: 'Pulisci', text: 'Valori mancanti, duplicati, date sbagliate. Con pandas e SQL.', icon: 'filter', fase: 'Fase 1' },
  { code: 'model', name: 'Modella', text: 'Tabelle ordinate e collegate, con dbt, DuckDB e PostgreSQL.', icon: 'layers', fase: 'Fase 2' },
  { code: 'analyze', name: 'Analizza', text: 'Aggregazioni, trend, statistica e un po\' di machine learning.', icon: 'chart', fase: 'Fasi 3–4' },
  { code: 'tell', name: 'Racconta', text: 'Grafici e dashboard che aiutano a prendere una decisione.', icon: 'presentation', fase: 'Fase 3' },
] as const;
---
<Base title="Accademia Dati" description="Un percorso di data intelligence da zero: 14 mesi, 5–8 ore a settimana, un progetto reale per ogni fase.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Data intelligence · da zero · 5–8 ore a settimana</span>
        <h1>Dai dati grezzi alle decisioni, <span class="hl">una settimana alla volta.</span></h1>
        <p class="lead">Un percorso di circa 14 mesi per imparare a raccogliere, pulire, modellare e raccontare i dati. Ogni fase si chiude con un progetto vero su GitHub: è quello, più dei certificati, che dimostra cosa sai fare.</p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/fase-1/settimana-01/')}>Inizia dalla settimana 1 <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={url('/percorso/')}>Vedi il percorso completo</a>
        </div>
        <dl class="facts">
          <div><dt>Durata</dt><dd>~14 mesi</dd></div>
          <div><dt>Impegno</dt><dd>5–8 h/sett.</dd></div>
          <div><dt>Budget 1° anno</dt><dd>0–300 €</dd></div>
          <div><dt>Progetti</dt><dd>5</dd></div>
        </dl>
      </div>
      <div class="hero-side">
        <ProgressCard />
        <pre class="query" aria-label="Esempio di query SQL della settimana 7"><code><span class="c">-- settimana 07 · variazione mese su mese</span>
<span class="k">SELECT</span> mese, totale,
  totale - <span class="f">LAG</span>(totale)
    <span class="k">OVER</span> (<span class="k">ORDER BY</span> mese) <span class="k">AS</span> delta
<span class="k">FROM</span> mensile;</code></pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cosa fa chi lavora con i dati</span>
        <h2>La pipeline che imparerai a costruire</h2>
        <p class="lead">Data intelligence significa portare un dato da “file disordinato” a “risposta a una domanda”. Ogni fase del percorso copre un pezzo di questa catena.</p>
      </div>
      <ol class="pipe">
        {pipeline.map((s) => (
          <li class="step card">
            <div class="step-top">
              <span class="step-icon"><Icon name={s.icon} size={20} /></span>
              <code>{s.code}()</code>
            </div>
            <h3>{s.name}</h3>
            <p class="muted">{s.text}</p>
            <span class="step-fase">{s.fase}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Perché i dati prima della cybersecurity</span>
        <h2>La scelta, in tre motivi</h2>
      </div>
      <div class="why">
        <article>
          <Icon name="target" size={24} />
          <h3>Risultati visibili ogni settimana</h3>
          <p class="muted">Con 5–8 ore serve un campo dove ogni sessione produce qualcosa: una query che funziona, un grafico, una tabella pulita. Così la motivazione resta alta.</p>
        </article>
        <article>
          <Icon name="layers" size={24} />
          <h3>Basi che valgono ovunque</h3>
          <p class="muted">Python, SQL, Linux e reti servono sia nei dati sia nella sicurezza. Se poi cambi strada, nulla di quello che studi qui va sprecato.</p>
        </article>
        <article>
          <Icon name="shield" size={24} />
          <h3>Il ponte esiste già</h3>
          <p class="muted">Threat intelligence e SOC sono lavori sui dati: log, eventi, indicatori. La Fase 4 ti porta proprio lì. <a href={url('/cybersecurity/')}>Scopri come</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Il metodo</span>
        <h2>Una settimana tipo</h2>
        <p class="lead">Tre sessioni fisse in calendario. La costanza conta più dell'intensità.</p>
      </div>
      <div class="rhythm">
        <div class="card"><span class="eyebrow">Sessione A · 2 h</span><h3>Teoria</h3><p class="muted">Lezione o capitolo della risorsa indicata, con appunti scritti a mano o nel diario.</p></div>
        <div class="card"><span class="eyebrow">Sessione B · 2 h</span><h3>Pratica</h3><p class="muted">L'esercizio della settimana, scritto da te senza copiare la soluzione.</p></div>
        <div class="card"><span class="eyebrow">Sessione C · 1–2 h</span><h3>Diario</h3><p class="muted">Commit su GitHub e tre righe: cosa ho capito, cosa no, cosa provo la prossima volta.</p></div>
      </div>
      <a class="btn btn-primary" href={url('/fase-1/')}>Vai alle lezioni della Fase 1 <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-3xl) var(--space-2xl); background:
    radial-gradient(1200px 400px at 85% -10%, var(--color-primary-soft), transparent 70%); }
  .hero-grid { display: grid; gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: var(--space-lg); }
  .hl { color: var(--color-primary); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: var(--space-md); margin: var(--space-sm) 0 0; padding-top: var(--space-lg); border-top: 1px solid var(--color-border); }
  .facts div { display: grid; gap: 2px; }
  .facts dt { font-size: 0.8rem; color: var(--color-muted-foreground); }
  .facts dd { margin: 0; font-family: var(--font-mono); font-weight: 600; font-size: 1.1rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hero-side { display: grid; gap: var(--space-md); min-width: 0; }
  .query { margin: 0; background: var(--code-bg); color: var(--code-fg); border-radius: var(--radius-lg); padding: var(--space-lg); font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.65; overflow-x: auto; }
  .query code { background: none; padding: 0; }
  .query .k { color: var(--code-kw); } .query .f { color: var(--code-fn); } .query .c { color: var(--code-str); }

  .pipe { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); counter-reset: s; }
  .step { padding: var(--space-lg); display: grid; gap: var(--space-sm); align-content: start; position: relative; transition: border-color 200ms var(--ease), transform 200ms var(--ease); }
  .step:hover { border-color: var(--color-primary); }
  .step-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .step-icon { width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; background: var(--color-primary-soft); color: var(--color-primary); }
  .step code { font-size: 0.75rem; background: transparent; color: var(--color-muted-foreground); padding: 0; }
  .step-fase { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-accent); margin-top: auto; }

  .why { display: grid; gap: var(--space-xl); grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
  .why article { display: grid; gap: var(--space-sm); align-content: start; }
  .why article > :global(svg) { color: var(--color-primary); }

  .rhythm { display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: var(--space-xl); }
  .rhythm .card { padding: var(--space-lg); display: grid; gap: var(--space-xs); align-content: start; }
</style>
