---
import { url } from '../lib/url';
const target = url('/percorso/#progetti');
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>Progetti · Accademia Dati</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body><p>I progetti ora sono nella pagina <a href={target}>Percorso</a>.</p></body>
</html>
