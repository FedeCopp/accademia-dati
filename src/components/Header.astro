---
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { href: '/percorso/', label: 'Percorso', key: 'percorso' },
  { href: '/fase-1/', label: 'Fase 1', key: 'fase-1' },
  { href: '/progetti/', label: 'Progetti', key: 'progetti' },
  { href: '/cybersecurity/', label: 'Cybersecurity', key: 'cybersecurity' },
  { href: '/glossario/', label: 'Glossario', key: 'glossario' },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label="Accademia Dati, home">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <rect x="1" y="14" width="5" height="11" rx="1.5" fill="var(--color-border-strong)" />
        <rect x="8.5" y="8" width="5" height="17" rx="1.5" fill="var(--color-border-strong)" />
        <rect x="16" y="3" width="5" height="22" rx="1.5" fill="var(--color-primary)" />
        <circle cx="23" cy="3" r="2.5" fill="var(--color-accent-fill)" />
      </svg>
      <span>accademia<b>.dati</b></span>
    </a>

    <nav class="nav" id="nav-principale" aria-label="Navigazione principale">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <a class="icon-btn" href={url('/cerca/')} aria-label="Cerca nel sito"><Icon name="search" /></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Cambia tema chiaro o scuro">
        <Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" />
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="nav-principale" aria-label="Apri il menu" data-menu>
        <Icon name="menu" class="i-open" /><Icon name="x" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('accademia-dati-theme', next); } catch { /* ignora */ }
  });
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
    document.querySelector('.site-header')?.classList.toggle('menu-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .bar { display: flex; align-items: center; gap: var(--space-md); min-height: var(--header-h); }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none;
    color: var(--color-foreground); font-family: var(--font-heading); font-weight: 500; font-size: 1rem;
  }
  .brand b { color: var(--color-primary); font-weight: 600; }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 0.8rem; border-radius: var(--radius-sm);
    color: var(--color-muted-foreground); text-decoration: none; font-weight: 500; font-size: 0.93rem;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .nav a:hover { background: var(--color-muted); color: var(--color-foreground); }
  .nav a[aria-current='page'] { color: var(--color-primary); background: var(--color-primary-soft); }
  .tools { display: flex; gap: 2px; }
  .icon-btn {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-sm);
    color: var(--color-muted-foreground); background: transparent; border: 0; cursor: pointer;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .icon-btn:hover { background: var(--color-muted); color: var(--color-foreground); }
  .icon-btn :global(.i-moon), .icon-btn :global(.i-close) { display: none; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-sun) { display: none; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-moon) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-btn :global(.i-sun) { display: none; }
    :global(:root:not([data-theme='light'])) .icon-btn :global(.i-moon) { display: block; }
  }
  .menu-btn { display: none; }

  @media (max-width: 860px) {
    .tools { margin-left: auto; }
    .menu-btn { display: inline-grid; }
    .nav { display: none; position: absolute; inset: 100% 0 auto; background: var(--color-surface); border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow-md); }
    .menu-open .nav { display: block; }
    .menu-open .icon-btn :global(.i-open) { display: none; }
    .menu-open .icon-btn :global(.i-close) { display: block; }
    .nav ul { flex-direction: column; padding: var(--space-sm) max(16px, env(safe-area-inset-right, 0px)) var(--space-md) max(16px, env(safe-area-inset-left, 0px)); }
    .nav a { min-height: 48px; width: 100%; font-size: 1rem; }
  }
</style>
