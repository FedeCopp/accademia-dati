---
import Icon from './Icon.astro';
import { ProgressRing } from '@/components/ui/progress-ring';
import { url } from '../lib/url';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class:list={['progress card', { compact }]}>
  <ProgressRing client:load className="progress-ring" />
  <div class="info">
    <span class="eyebrow">Fase 1 · i tuoi progressi</span>
    <p class="count"><span data-progress-count>0 / 12</span> settimane</p>
    <a class="next" href={url('/fase-1/settimana-01/')} data-next-week>
      <span class="muted small">Prossima lezione</span>
      <span class="row"><span data-label>Settimana 1 · Attrezzatura e metodo</span><Icon name="arrow-right" size={18} /></span>
    </a>
  </div>
</div>
<style>
  .progress { display: flex; gap: var(--space-lg); align-items: center; padding: var(--space-lg); box-shadow: var(--shadow-md); }
  .info { display: grid; gap: 4px; min-width: 0; }
  .count { font-weight: 700; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .next { display: grid; gap: 0; margin-top: 6px; text-decoration: none; color: var(--color-primary); }
  .small { font-size: 0.82rem; }
  .row { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; min-height: 32px; }
  .row :global(svg) { flex: none; transition: transform var(--dur-base) var(--ease-out); }
  .next:hover .row :global(svg) { transform: translateX(4px); }
  .next:hover [data-label] { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 420px) { .progress { gap: var(--space-md); padding: var(--space-md); } }
</style>
